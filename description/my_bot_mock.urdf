<?xml version="1.0"?>
<robot name="my_bot">

  <!-- ============================================================
       PLACEHOLDER DIMENSIONS. Measure your actual chassis and
       update wheel_separation/wheel_radius (here AND in
       diffdrive_controllers.yaml), and the laser_joint origin to
       match where your RPLidar is actually mounted, before trusting
       any of this for real navigation.
       ============================================================ -->

  <material name="grey">  <color rgba="0.5 0.5 0.5 1"/></material>
  <material name="black"> <color rgba="0.1 0.1 0.1 1"/></material>
  <material name="red">   <color rgba="0.8 0.1 0.1 1"/></material>

  <!-- ===================== BASE LINK ===================== -->
  <link name="base_link">
    <visual>
      <geometry><box size="0.30 0.25 0.10"/></geometry>
      <material name="grey"/>
    </visual>
    <collision>
      <geometry><box size="0.30 0.25 0.10"/></geometry>
    </collision>
    <inertial>
      <mass value="3.0"/>
      <inertia ixx="0.02" ixy="0" ixz="0" iyy="0.03" iyz="0" izz="0.04"/>
    </inertial>
  </link>

  <!-- ===================== LEFT WHEEL ===================== -->
  <link name="left_wheel_link">
    <visual>
      <origin xyz="0 0 0" rpy="1.5708 0 0"/>
      <geometry><cylinder radius="0.05" length="0.03"/></geometry>
      <material name="black"/>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="1.5708 0 0"/>
      <geometry><cylinder radius="0.05" length="0.03"/></geometry>
    </collision>
    <inertial>
      <mass value="0.2"/>
      <inertia ixx="0.0002" ixy="0" ixz="0" iyy="0.0002" iyz="0" izz="0.0002"/>
    </inertial>
  </link>

  <joint name="left_wheel_joint" type="continuous">
    <parent link="base_link"/>
    <child link="left_wheel_link"/>
    <origin xyz="0 0.15 -0.03" rpy="0 0 0"/>
    <axis xyz="0 1 0"/>
  </joint>

  <!-- ===================== RIGHT WHEEL ===================== -->
  <link name="right_wheel_link">
    <visual>
      <origin xyz="0 0 0" rpy="1.5708 0 0"/>
      <geometry><cylinder radius="0.05" length="0.03"/></geometry>
      <material name="black"/>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="1.5708 0 0"/>
      <geometry><cylinder radius="0.05" length="0.03"/></geometry>
    </collision>
    <inertial>
      <mass value="0.2"/>
      <inertia ixx="0.0002" ixy="0" ixz="0" iyy="0.0002" iyz="0" izz="0.0002"/>
    </inertial>
  </link>

  <joint name="right_wheel_joint" type="continuous">
    <parent link="base_link"/>
    <child link="right_wheel_link"/>
    <origin xyz="0 -0.15 -0.03" rpy="0 0 0"/>
    <axis xyz="0 1 0"/>
  </joint>

  <!-- ============== CASTER (passive, visual/collision only, no joint to control) ============== -->
  <link name="caster_wheel_link">
    <visual>
      <geometry><sphere radius="0.025"/></geometry>
      <material name="black"/>
    </visual>
    <collision>
      <geometry><sphere radius="0.025"/></geometry>
    </collision>
    <inertial>
      <mass value="0.05"/>
      <inertia ixx="0.00001" ixy="0" ixz="0" iyy="0.00001" iyz="0" izz="0.00001"/>
    </inertial>
  </link>

  <joint name="caster_wheel_joint" type="fixed">
    <parent link="base_link"/>
    <child link="caster_wheel_link"/>
    <origin xyz="0.12 0 -0.05" rpy="0 0 0"/>
  </joint>

  <!-- ===================== LIDAR ===================== -->
  <!-- frame name "laser_frame" matches the frame_id you're already
       passing to rplidar_ros and rf2o -->
  <link name="laser_frame">
    <visual>
      <geometry><cylinder radius="0.03" length="0.04"/></geometry>
      <material name="red"/>
    </visual>
    <collision>
      <geometry><cylinder radius="0.03" length="0.04"/></geometry>
    </collision>
    <inertial>
      <mass value="0.1"/>
      <inertia ixx="0.00005" ixy="0" ixz="0" iyy="0.00005" iyz="0" izz="0.00005"/>
    </inertial>
  </link>

  <joint name="laser_joint" type="fixed">
    <parent link="base_link"/>
    <child link="laser_frame"/>
    <!-- CHANGE to your actual lidar mount position/height -->
    <origin xyz="0.10 0 0.08" rpy="0 0 0"/>
  </joint>

  <!-- ===================== ros2_control / MOCK HARDWARE ===================== -->
  <!-- Stand-in for diffdrive_arduino while the ESP32 isn't connected.
       Lets you verify controller_manager + diff_cont + twist_mux wiring
       end-to-end without any real serial device. Swap back to
       my_bot.urdf (the diffdrive_arduino version) once the ESP32 is
       plugged in for the real test. -->
  <ros2_control name="diffdrive_arduino" type="system">
    <hardware>
      <plugin>mock_components/GenericSystem</plugin>
      <param name="calculate_dynamics">true</param>
    </hardware>
    <joint name="left_wheel_joint">
      <command_interface name="velocity"/>
      <state_interface name="velocity"/>
      <state_interface name="position"/>
    </joint>
    <joint name="right_wheel_joint">
      <command_interface name="velocity"/>
      <state_interface name="velocity"/>
      <state_interface name="position"/>
    </joint>
  </ros2_control>

</robot>
