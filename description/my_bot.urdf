<?xml version="1.0"?>
<robot name="my_bot">

  <!-- ============================================================
       PLACEHOLDER DIMENSIONS. Measure your actual chassis and
       update wheel_separation/wheel_radius (here AND in
       diffdrive_controllers.yaml), and the laser_joint origin to
       match where your RPLidar is actually mounted, before trusting
       any of this for real navigation.
       ============================================================ -->

  <material name="grey">  <color rgba="0.5 0.5 0.5 1"/></material>
  <material name="black"> <color rgba="0.1 0.1 0.1 1"/></material>
  <material name="red">   <color rgba="0.8 0.1 0.1 1"/></material>

  <!-- ===================== BASE LINK ===================== -->
  <link name="base_link">
    <visual>
      <geometry><box size="0.30 0.25 0.10"/></geometry>
      <material name="grey"/>
    </visual>
    <collision>
      <geometry><box size="0.30 0.25 0.10"/></geometry>
    </collision>
    <inertial>
      <mass value="3.0"/>
      <inertia ixx="0.02" ixy="0" ixz="0" iyy="0.03" iyz="0" izz="0.04"/>
    </inertial>
  </link>

  <!-- ===================== LEFT WHEEL ===================== -->
  <link name="left_wheel_link">
    <visual>
      <origin xyz="0 0 0" rpy="1.5708 0 0"/>
      <geometry><cylinder radius="0.05" length="0.03"/></geometry>
      <material name="black"/>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="1.5708 0 0"/>
      <geometry><cylinder radius="0.05" length="0.03"/></geometry>
    </collision>
    <inertial>
      <mass value="0.2"/>
      <inertia ixx="0.0002" ixy="0" ixz="0" iyy="0.0002" iyz="0" izz="0.0002"/>
    </inertial>
  </link>

  <joint name="left_wheel_joint" type="continuous">
    <parent link="base_link"/>
    <child link="left_wheel_link"/>
    <origin xyz="0 0.15 -0.03" rpy="0 0 0"/>
    <axis xyz="0 1 0"/>
  </joint>

  <!-- ===================== RIGHT WHEEL ===================== -->
  <link name="right_wheel_link">
    <visual>
      <origin xyz="0 0 0" rpy="1.5708 0 0"/>
      <geometry><cylinder radius="0.05" length="0.03"/></geometry>
      <material name="black"/>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="1.5708 0 0"/>
      <geometry><cylinder radius="0.05" length="0.03"/></geometry>
    </collision>
    <inertial>
      <mass value="0.2"/>
      <inertia ixx="0.0002" ixy="0" ixz="0" iyy="0.0002" iyz="0" izz="0.0002"/>
    </inertial>
  </link>

  <joint name="right_wheel_joint" type="continuous">
    <parent link="base_link"/>
    <child link="right_wheel_link"/>
    <origin xyz="0 -0.15 -0.03" rpy="0 0 0"/>
    <axis xyz="0 1 0"/>
  </joint>

  <!-- ============== CASTER (passive, visual/collision only, no joint to control) ============== -->
  <link name="caster_wheel_link">
    <visual>
      <geometry><sphere radius="0.025"/></geometry>
      <material name="black"/>
    </visual>
    <collision>
      <geometry><sphere radius="0.025"/></geometry>
    </collision>
    <inertial>
      <mass value="0.05"/>
      <inertia ixx="0.00001" ixy="0" ixz="0" iyy="0.00001" iyz="0" izz="0.00001"/>
    </inertial>
  </link>

  <joint name="caster_wheel_joint" type="fixed">
    <parent link="base_link"/>
    <child link="caster_wheel_link"/>
    <origin xyz="0.12 0 -0.05" rpy="0 0 0"/>
  </joint>

  <!-- ===================== LIDAR ===================== -->
  <!-- frame name "laser_frame" matches the frame_id you're already
       passing to rplidar_ros and rf2o -->
  <link name="laser_frame">
    <visual>
      <geometry><cylinder radius="0.03" length="0.04"/></geometry>
      <material name="red"/>
    </visual>
    <collision>
      <geometry><cylinder radius="0.03" length="0.04"/></geometry>
    </collision>
    <inertial>
      <mass value="0.1"/>
      <inertia ixx="0.00005" ixy="0" ixz="0" iyy="0.00005" iyz="0" izz="0.00005"/>
    </inertial>
  </link>

  <joint name="laser_joint" type="fixed">
    <parent link="base_link"/>
    <child link="laser_frame"/>
    <!-- CHANGE to your actual lidar mount position/height -->
    <origin xyz="0.10 0 0.08" rpy="0 0 0"/>
  </joint>

  <!-- ZED 2i camera -->
<link name="zed_camera_link">
  <visual>
    <geometry><box size="0.175 0.030 0.033"/></geometry>
    <material name="grey"/>
  </visual>
  <inertial>
    <mass value="0.159"/>
    <inertia ixx="0.0001" ixy="0" ixz="0"
             iyy="0.0001" iyz="0" izz="0.0001"/>
  </inertial>
</link>

<joint name="zed_camera_joint" type="fixed">
  <parent link="base_link"/>
  <child link="zed_camera_link"/>
  <!-- CHANGE xyz to your actual mount position -->
  <!-- x: forward offset, z: height above base_link -->
  <origin xyz="0.10 0 0.15" rpy="0 0 0"/>
</joint>


  <!-- ===================== ros2_control / diffdrive_arduino ===================== -->
  <!-- read() is expected to be stubbed to open-loop integration (no real
       encoder query) per your hardware interface changes; write() still
       sends real "m <l> <r>\r" motor commands over serial as before. -->
  <ros2_control name="diffdrive_arduino" type="system">
    <hardware>
      <plugin>diffdrive_arduino/DiffDriveArduinoHardware</plugin>
      <param name="left_wheel_name">left_wheel_joint</param>
      <param name="right_wheel_name">right_wheel_joint</param>
      <param name="loop_rate">30</param>
      <param name="device">/dev/ttyUSB1</param>   <!-- CHANGE: ESP32 port, confirm it isn't clashing with the lidar's /dev/ttyUSB0 -->
      <param name="baud_rate">115200</param>
      <param name="timeout_ms">1000</param>
      <param name="enc_counts_per_rev">8011</param>  <!-- tuned so diffdrive_arduino's integer motor cmds map to 0-255 PWM range: 255 * 2pi * loop_rate / MAX_WHEEL_RAD_S -->
    </hardware>
    <joint name="left_wheel_joint">
      <command_interface name="velocity"/>
      <state_interface name="position"/>
      <state_interface name="velocity"/>
    </joint>
    <joint name="right_wheel_joint">
      <command_interface name="velocity"/>
      <state_interface name="position"/>
      <state_interface name="velocity"/>
    </joint>
  </ros2_control>

</robot>
